{
  "name": "rag-service",
  "version": "1.0.0",
  "description": "Production-ready Retrieval-Augmented-Generation service with OpenAI, Qdrant, and Redis",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --testPathPattern=tests/unit",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --testPathPattern=tests/integration",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "load-sample-data": "tsx scripts/load-sample-data.ts",
    "reset-db": "tsx scripts/reset-db.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "migrate:to-azure": "tsx scripts/migrate-vectors-to-azure.ts",
    "migrate:reindex": "tsx scripts/reindex-with-azure-embeddings.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts"
  },
  "keywords": [
    "RAG",
    "retrieval-augmented-generation",
    "openai",
    "qdrant",
    "redis",
    "vector-search"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/monitor-opentelemetry": "^1.15.1",
    "@azure/openai": "^2.0.0",
    "@azure/search-documents": "^12.2.0",
    "@azure/storage-blob": "^12.30.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.28.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
