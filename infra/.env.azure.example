# ===================================================================
# Azure RAG Service Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your Azure resource values
# This configuration is used when AZURE_MODE=true
# ===================================================================

# -------------------------------------------------------------------
# General Configuration
# -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Enable Azure mode (uses Azure services instead of OpenAI/Qdrant)
AZURE_MODE=true

# -------------------------------------------------------------------
# Azure OpenAI Configuration
# -------------------------------------------------------------------
# Get these values from your Azure OpenAI resource in Azure Portal
# Resource -> Keys and Endpoint

AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-api-key-here

# Or use Key Vault secret name instead of direct key
# AZURE_OPENAI_KEY_SECRET_NAME=azure-openai-api-key

# Deployment names (configured in main.bicep)
AZURE_OPENAI_GENERATION_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# API version (https://learn.microsoft.com/en-us/azure/ai-services/openai/reference)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -------------------------------------------------------------------
# Azure Cognitive Search Configuration
# -------------------------------------------------------------------
# Get these values from your Azure Search resource in Azure Portal
# Resource -> Keys

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key-here

# Or use Key Vault secret name instead of direct key
# AZURE_SEARCH_KEY_SECRET_NAME=azure-search-api-key

# Index configuration
AZURE_SEARCH_INDEX_NAME=rag-documents

# -------------------------------------------------------------------
# Azure Blob Storage Configuration
# -------------------------------------------------------------------
# Get these values from your Storage Account in Azure Portal
# Resource -> Access keys

AZURE_BLOB_ACCOUNT_NAME=yourstorageaccount
AZURE_BLOB_CONTAINER_NAME=documents

# Option 1: Use account key
AZURE_BLOB_ACCOUNT_KEY=your-storage-account-key-here

# Option 2: Use connection string
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Option 3: Use Key Vault secret
# AZURE_BLOB_KEY_SECRET_NAME=azure-blob-account-key

# -------------------------------------------------------------------
# Azure Cache for Redis Configuration
# -------------------------------------------------------------------
# Get these values from your Redis Cache in Azure Portal
# Resource -> Access keys

AZURE_REDIS_HOST=your-redis-cache.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=your-redis-password-here

# Or use connection string
# AZURE_REDIS_CONNECTION_STRING=your-redis-cache.redis.cache.windows.net:6380,password=xxx,ssl=True,abortConnect=False

# Or use Key Vault secret
# AZURE_REDIS_PASSWORD_SECRET_NAME=azure-redis-password

# -------------------------------------------------------------------
# Azure Key Vault Configuration (Optional but Recommended)
# -------------------------------------------------------------------
# If you want to store secrets in Key Vault instead of environment variables
# The managed identity must have "Key Vault Secrets User" role

AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Use DefaultAzureCredential (managed identity, Azure CLI, etc.)
AZURE_KEYVAULT_USE_DEFAULT_CREDENTIAL=true

# -------------------------------------------------------------------
# Azure Managed Identity Configuration
# -------------------------------------------------------------------
# When running in Azure Container Apps, these are set automatically
# For local development with Azure CLI: az login

# User-assigned managed identity client ID (optional)
# AZURE_CLIENT_ID=your-managed-identity-client-id

# -------------------------------------------------------------------
# Application Insights Configuration
# -------------------------------------------------------------------
# Get these values from your Application Insights resource
# Resource -> Properties

APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://...
# APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key-here

# -------------------------------------------------------------------
# RAG Service Configuration
# -------------------------------------------------------------------
# How many documents to retrieve for context
RAG_TOP_K=5

# Maximum tokens for LLM responses
RAG_MAX_TOKENS=1000

# Temperature for generation (0.0 - 2.0)
RAG_TEMPERATURE=0.7

# Chunk size for document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# -------------------------------------------------------------------
# API Security (Optional)
# -------------------------------------------------------------------
# JWT secret for API authentication (if using auth)
# JWT_SECRET=your-jwt-secret-here

# API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------------------------------
# Local Development Only
# -------------------------------------------------------------------
# When developing locally and testing Azure services
# Make sure you're logged in: az login

# Set to true to enable detailed Azure SDK logging
# AZURE_LOG_LEVEL=info

# -------------------------------------------------------------------
# Notes
# -------------------------------------------------------------------
# 1. For production, use Key Vault to store all secrets
# 2. For Container Apps, set these as environment variables or secrets in the template
# 3. Never commit this file with actual values to version control
# 4. Use managed identity instead of keys whenever possible
# 5. Rotate keys regularly using Azure Key Vault
# ===================================================================
