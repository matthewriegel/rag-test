# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_TIMEOUT_MS=30000

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_API_KEY=

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTLs (in seconds)
CACHE_QUERY_TTL=3600
CACHE_CUSTOMER_TTL=86400
CACHE_EMBEDDING_TTL=604800

# RAG Configuration
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# Confidence Score Weights (must sum to 1.0)
CONFIDENCE_WEIGHT_SIMILARITY=0.5
CONFIDENCE_WEIGHT_METADATA=0.3
CONFIDENCE_WEIGHT_LLM=0.2

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
API_KEY=your-api-key-for-admin-endpoints

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
