# Azure Configuration Example
# Copy this to .env.local and fill in your values for Azure mode

# Enable Azure mode (set to 'true' to use Azure services, 'false' for local Qdrant/OpenAI)
AZURE_MODE=false

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
# Or use Key Vault secret name instead of direct key
# AZURE_OPENAI_KEY_SECRET_NAME=openai-api-key

# Azure OpenAI Deployment Names (must match your deployed models)
AZURE_OPENAI_GENERATION_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Search (Cognitive Search)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key-here
# Or use Key Vault secret name
# AZURE_SEARCH_KEY_SECRET_NAME=search-api-key
AZURE_SEARCH_INDEX_NAME=rag-documents

# Azure Blob Storage
AZURE_BLOB_ACCOUNT_NAME=yourstorageaccount
AZURE_BLOB_CONTAINER_NAME=documents
# Option 1: Use connection string
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# Option 2: Use account key
# AZURE_BLOB_ACCOUNT_KEY=your-storage-account-key
# Option 3: Use Key Vault secret name
# AZURE_BLOB_KEY_SECRET_NAME=blob-storage-key

# Azure Cache for Redis
# Option 1: Use connection string
AZURE_REDIS_CONNECTION_STRING=your-redis-name.redis.cache.windows.net:6380,password=...,ssl=True
# Option 2: Use individual components
# AZURE_REDIS_HOST=your-redis-name.redis.cache.windows.net
# AZURE_REDIS_PORT=6380
# AZURE_REDIS_PASSWORD=your-redis-access-key
# Option 3: Use Key Vault secret name
# AZURE_REDIS_PASSWORD_SECRET_NAME=redis-password

# Azure Key Vault (for secrets management in production)
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_KEYVAULT_USE_DEFAULT_CREDENTIAL=true

# Application Insights (for telemetry and monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# Or just the instrumentation key
# APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key

# Notes:
# - In production, use Azure Managed Identity + Key Vault for secrets
# - In development, you can use direct keys in .env.local (not committed to git)
# - Set AZURE_MODE=true to enable Azure services
# - Set AZURE_MODE=false to use local Qdrant and direct OpenAI (for development/comparison)
